# Temporada atual da NBA (ajustar conforme necessário)
NBA_SEASON=2025

# Banco de Dados (PostgreSQL)
POSTGRES_USER=seu_user
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=nba_score_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=seu_email
PGADMIN_PASSWORD=sua_senha

# API-Sports (NBA v2)
API_SPORTS_KEY=sua_chave_api_sports
API_SPORTS_BASE_URL=https://v2.nba.api-sports.io

# Backend / FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development

# Origem do frontend (para CORS)
FRONTEND_ORIGIN=http://localhost:8000

# Onerb IA - chatbot
# Crie uma conta gratuita em https://console.groq.com para obter a GROQ_API_KEY
# Crie uma conta gratuita em https://app.tavily.com para obter a TAVILY_API_KEY
GROQ_API_KEY=sua_chave_groq
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=sua_chave_tavily

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=sua_fernet_key
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Credenciais Airflow Web UI
AIRFLOW_ADMIN_USERNAME=seu_user
AIRFLOW_ADMIN_PASSWORD=sua_senha
AIRFLOW_ADMIN_EMAIL=seu_email

# Conexão DB para Airflow
AIRFLOW_DB_USER=seu_user
AIRFLOW_DB_PASSWORD=sua_senha
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432

# Segurança JWT
SECRET_KEY=uma_string_secreta_longa_e_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Misc / Observabilidade
LOG_LEVEL=INFO

# Margens do modelo preditivo
MARGEM_PONTOS=4.0
MARGEM_ASSISTENCIAS=2.5
MARGEM_REBOTES=3.0
MARGEM_ROUBOS=1.5
MARGEM_BLOQUEIOS=1.0

# Parâmetros de elegibilidade do modelo preditivo
MIN_MINUTOS_PALPITE=20.0
JANELA_JOGOS_RECENTES=15
JOGOS_CHECAGEM_ATIVIDADE=10
MIN_MINUTOS_JOGO_RECENTE=2.0
COEF_VARIACAO_MAXIMO=0.75

# Caminhos de saída do pipeline ML
PASTA_MODELOS=/opt/airflow/modelos_ml
PASTA_RELATORIOS=/opt/airflow/relatorios_ml

# E-mail (recuperação de senha, confirmação de conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=seu@gmail.com
SMTP_SENHA=sua_senha_de_app
SMTP_REMETENTE=NbaAnalytics <seu@gmail.com>
FRONTEND_URL=http://localhost:3000
